<section class="min-h-screen bg-ui-bg flex flex-col justify-between p-6 sm:p-12">
    <main class="flex-1 container mx-auto max-w-2xl flex flex-col justify-center items-center text-center space-y-6">
        <div class="container flex flex-col flex-1 justify-around">
            <header class="space-y-2">
                <h1 class="bg-linear-to-r from-brand-primary from-40% to-brand-secondary bg-clip-text text-transparent drop-shadow-xl drop-shadow-brand-primary/30 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight">
                    Scribble To...
                </h1>
                <div class="text-grey-7 flex-row sm:flex-row justify-center gap-5 pt-1 text-sm font-semibold">
                    <span class="inline-flex items-center gap-1.5  tracking-wide">
                        <svg class="w-4 h-4 shrink-0 text-brand-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 6L9 17l-5-5"></path>
                        </svg>
                        No Tracking
                    </span>
                    <span class="inline-flex flex-row items-center gap-1.5 tracking-wide">
                        <svg class="w-4 h-4 shrink-0 text-brand-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 6L9 17l-5-5"></path>
                        </svg>
                        Not used for AI training
                    </span>
                    <span class="inline-flex flex-row items-center gap-1.5 tracking-wide">
                        <svg class="w-4 h-4 shrink-0 text-brand-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 6L9 17l-5-5"></path>
                        </svg>
                        Public or Private
                    </span>
                </div>
            </header>

            <div class="text-grey-7 text-xl font-semibold  tracking-wide text-shadow-md">
                The simplest way to create quick notes with custom links: Just name it, create and start writing.
            </div>

            <div class="w-full mb-15">
                <div class="relative isolate w-full flex flex-col justify-center">

                    <div class="absolute top-[38%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[70%] h-[80%] bg-brand-primary/15 blur-[200px] pointer-events-none rounded-full -z-10">
                    </div>

                    <%= render "indexForm" %>
                </div>
            </div>
        </div>
    </main>

    <footer class="w-full max-w-2xl mx-auto flex justify-between items-center pt-8">
        <button type="button" class="<%= button_classes(:secondary) %>">
            Help
        </button>

        <button type="button" class="<%= button_classes(:secondary) %>">
            Theme
        </button>
    </footer>
</section>
